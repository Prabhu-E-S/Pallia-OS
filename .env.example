# ------------------------------------------------------------------
# Pallia OS - environment template
# Copy to `.env` and fill in real values for local development.
# Never commit real secrets.
# ------------------------------------------------------------------

# Application
ENVIRONMENT=development
# Comma-separated origins allowed by the API's CORS middleware.
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (used by docker-compose)
POSTGRES_USER=pallia
POSTGRES_PASSWORD=pallia
POSTGRES_DB=pallia
# Published host port for Postgres. 5432 is occupied by a Windows-native
# install on this machine, so local development uses 55432.
POSTGRES_PORT=55432

# Backend API
# Local development value when running the API directly on the host.
DATABASE_URL=postgresql+psycopg://pallia:pallia@localhost:55432/pallia
SECRET_KEY=replace-me-with-a-long-random-string
# 8000 is occupied here too (Docker/WSL proxy) -> run the API on 8001.
API_PORT=8001

# Frontend
# Base URL the browser uses to reach the API.
# Leave empty for a same-origin reverse proxy, or set http://localhost:8001
# for local development when the API runs on its own port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
WEB_PORT=3000